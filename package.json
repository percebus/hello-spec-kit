{
  "name": "hello-spec-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "npm:install:global": "npm install --location=global serve @github/copilot",
    "setup": "npm run npm:install:global",
    "_prettier": "prettier .",
    "prettier:check": "npm run _prettier -- --check",
    "prettier:write": "npm run _prettier -- --write",
    "tsc": "tsc --noEmit",
    "next:dev": "next dev",
    "next:build": "next build",
    "serve:out": "npx serve out",
    "vite:playwright": "npx vite --config playwright/vite.config.mts",
    "bddgen": "bddgen",
    "playwright:install": "npx playwright install --with-deps chromium",
    "preplaywright:test": "npm run bddgen",
    "playwright:test": "playwright test",
    "playwright:test:unit": "npm run playwright:test -- tests/unit",
    "playwright:test:all": "npm run playwright:test -- --fully-parallel --workers=4",
    "playwright:test:e2e": "npm run playwright:test -- --fully-parallel --workers=4 tests/e2e",
    "_node:test": "node --test",
    "node:test:aw": "npm run _node:test -- ./.github/aw/scripts/*.test.mjs",
    "postinstall": "npm run playwright:install",
    "lint": "npm run prettier:check && npm run tsc",
    "format": "npm run prettier:write",
    "predev": "npm run format",
    "dev": "npm run next:dev",
    "out": "npm run next:build",
    "postformat": "npm run lint",
    "start": "npm run serve:out",
    "start:test": "node scripts/serve-static-export.mjs",
    "prebuild": "npm run lint",
    "build": "npm run next:build",
    "test:unit": "npm run node:test:aw && npm run playwright:test:unit",
    "test:all": "npm run node:test:aw && npm run playwright:test:all",
    "test:e2e": "npm run playwright:test:e2e",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "next": "^16.4.0-canary.51",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.5",
    "hve-core": "github:microsoft/hve-core#hve-core-v3.3.101",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
