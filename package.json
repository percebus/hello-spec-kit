{
  "name": "hello-spec-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "_prettier": "prettier .",
    "prettier:check": "npm run _prettier -- --check",
    "prettier:write": "npm run _prettier -- --write",
    "tsc": "tsc --noEmit",
    "next:dev": "next dev",
    "next:build": "next build",
    "serve:out": "npx serve out",
    "bddgen": "bddgen",
    "playwright:install": "npx playwright install --with-deps chromium",
    "preplaywright:test": "npm run bddgen",
    "playwright:test": "ENV=${ENV:-development} NODE_OPTIONS=--env-file=.env.${ENV:-development} playwright test --fully-parallel --workers=4",
    "postinstall": "npm run playwright:install",
    "lint": "npm run prettier:check && npm run tsc",
    "format": "npm run prettier:write",
    "predev": "npm run format",
    "dev": "npm run next:dev",
    "out": "npm run next:build",
    "postformat": "npm run lint",
    "start": "npm run serve:out",
    "prebuild": "npm run lint",
    "build": "npm run next:build",
    "test": "npm run playwright:test"
  },
  "dependencies": {
    "next": "^16.4.0-canary.51",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
